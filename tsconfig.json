{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2018",
    "allowJs": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop":true,
    "lib": [
      "dom",
      "es5",
      "scripthost",
      "es2015"
    ],
    "rootDir": "src",
    "outDir": "build",
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","build/**/*"],
}
